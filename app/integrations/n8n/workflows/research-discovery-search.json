        "options": {}
      },
      "id": "e2d9748f-e7fb-4c31-8c40-9942df7f0002",
      "name": "Edit search settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { topic: $json.topic, provider: $json.provider, limit: $json.limit, expand: $json.expand } }}",
        "options": { "timeout": 15000 }
      },
      "id": "e2d9748f-e7fb-4c31-8c40-9942df7f0003",
      "name": "Submit Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    },
    {
      "parameters": { "amount": 2, "unit": "seconds" },
      "id": "e2d9748f-e7fb-4c31-8c40-9942df7f0004",
      "name": "Wait before checking",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [920, 300]
    },
    {
      "parameters": {
        "url": "={{ 'http://127.0.0.1:8765' + $('Submit Search').first().json.status_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": { "timeout": 15000 }
      },
      "id": "e2d9748f-e7fb-4c31-8c40-9942df7f0005",
      "name": "Get Search Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            { "id": "e2d9748f-e7fb-4c31-8c40-9942df7f0021", "leftValue": "={{ ['queued', 'running'].includes($json.status) && $runIndex < 29 }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e2d9748f-e7fb-4c31-8c40-9942df7f0006",
      "name": "Still running?",
      "type": "n8n-nodes-base.if",
