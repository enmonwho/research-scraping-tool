            { "id": "e2d9748f-e7fb-4c31-8c40-9942df7f0012", "name": "provider", "value": "all", "type": "string" },
            { "id": "e2d9748f-e7fb-4c31-8c40-9942df7f0013", "name": "limit", "value": 10, "type": "number" },
